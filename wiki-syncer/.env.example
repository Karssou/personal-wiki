NEXTCLOUD_BASE_URL=https://cloud.example.com/remote.php/dav/files/USER/
NEXTCLOUD_USERNAME=wiki-reader
NEXTCLOUD_APP_PASSWORD=mot-de-passe-application

NEXTCLOUD_REMOTE_DIR=Wiki

STORAGE_DIR=/app/storage

# Nombre maximal de téléchargements simultanés (1 à 32)
DOWNLOAD_CONCURRENCY=4

# Délais maximum des requêtes réseau (en millisecondes)
SCAN_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=120000

# Niveau de logs : info (normal) ou debug (détails WebDAV et durée de chaque fichier)
LOG_LEVEL=info
